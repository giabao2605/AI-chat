# Shared provider URL. Use an OpenAI-compatible base URL that exposes /chat/completions.
PROVIDER_BASE_URL=
PROVIDER_TIMEOUT_MS=120000

# Agent A (required)
AGENT_A_NAME=GPT
AGENT_A_API_KEY=
AGENT_A_MODEL=model-a
AGENT_A_BASE_URL=
# AGENT_A_TIMEOUT_MS=120000

# Agent B (required)
AGENT_B_NAME=Claude
AGENT_B_API_KEY=
AGENT_B_MODEL=model-b
AGENT_B_BASE_URL=
# AGENT_B_TIMEOUT_MS=120000

# Agent C (optional). When fully configured it automatically joins the room/UI.
AGENT_C_NAME=Agent C
AGENT_C_API_KEY=
AGENT_C_MODEL=
AGENT_C_BASE_URL=
# AGENT_C_TIMEOUT_MS=120000

# Agent D (optional). When fully configured it automatically joins the room/UI.
AGENT_D_NAME=Agent D
AGENT_D_API_KEY=
AGENT_D_MODEL=
AGENT_D_BASE_URL=
# AGENT_D_TIMEOUT_MS=120000

# Independent web search tool (Tavily Search API).
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_COUNTRY=
WEB_SEARCH_MAX_QUERIES=2
WEB_SEARCH_RESULTS_PER_QUERY=8
WEB_SEARCH_MAX_SOURCES=8
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_TRUSTED_DOMAINS=
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search

# Optional second-stage reader: fetch the top result pages after Tavily returns snippets.
# Web evidence is inserted as untrusted user/tool data, never merged into the system prompt.
WEB_RESEARCH_DEEP_ENABLED=true
WEB_RESEARCH_DEEP_MAX_SOURCES=2
WEB_RESEARCH_DEEP_MAX_CHARS=9000
WEB_RESEARCH_DEEP_TIMEOUT_MS=9000

# Context manager. Old turns are summarized so request size does not grow forever.
CONTEXT_RECENT_MESSAGES=18
CONTEXT_SUMMARIZE_AFTER=28
CONTEXT_SUMMARY_CHUNK=16
CONTEXT_SUMMARY_MAX_CHARS=6500
LOOP_SIMILARITY_THRESHOLD=0.74

# Independent image generation tool used by /img_gen and autonomous agent tool calls.
IMAGE_GEN_ENABLED=true
IMAGE_GEN_PROVIDER=cloudflare
IMAGE_GEN_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_GEN_TIMEOUT_MS=120000
IMAGE_GEN_MAX_BYTES=26214400
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_ENDPOINT=
IMAGE_GEN_SIZE=1024x1024

# Pass generated images back into the active AI agents.
MODEL_IMAGE_INPUT_ENABLED=true
MODEL_IMAGE_MAX_ATTACHMENTS=1
MODEL_IMAGE_MAX_BYTES=8388608

# Allow AI agents themselves to call generate_image during a normal turn.
AGENT_IMAGE_TOOL_ENABLED=true
AGENT_IMAGE_TOOL_MAX_CALLS_PER_TURN=1

# Legacy two-agent auto-end remains off by default. Multi-agent runtime currently ends by turn limit/user control.
AGENT_AUTO_END_ENABLED=false

# Server / room isolation.
HOST=127.0.0.1
PORT=3000
HARD_TURN_LIMIT=200
# Set false to force every tab/client into one shared default-room without removing multi-room code.
MULTI_ROOM_ENABLED=true
MAX_ROOMS=30
ROOM_TTL_MS=43200000
