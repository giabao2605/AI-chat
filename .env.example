# Shared provider URL. Use an OpenAI-compatible base URL that exposes /chat/completions.
PROVIDER_BASE_URL=

# Agent A
AGENT_A_NAME=GPT
AGENT_A_API_KEY=
AGENT_A_MODEL=model-a
AGENT_A_BASE_URL=

# Agent B
AGENT_B_NAME=Claude
AGENT_B_API_KEY=
AGENT_B_MODEL=model-b
AGENT_B_BASE_URL=

# Independent web search tool (Brave Search API).
# When BRAVE_SEARCH_API_KEY is present, web search is enabled by default.
# Set WEB_SEARCH_ENABLED=false to disable it without removing the key.
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_COUNTRY=VN
WEB_SEARCH_LANGUAGE=vi
WEB_SEARCH_RESULTS_PER_QUERY=8
WEB_SEARCH_MAX_SOURCES=8
WEB_SEARCH_TIMEOUT_MS=15000
# Optional comma-separated domains to boost in ranking, e.g. who.int,nasa.gov,reuters.com
WEB_SEARCH_TRUSTED_DOMAINS=
# Usually leave this unchanged. Useful for mocks/self-hosted compatible gateways.
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search

# Server
HOST=127.0.0.1
PORT=3000

# Safety guard against an accidental infinite paid loop.
HARD_TURN_LIMIT=200
