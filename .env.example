# ==========================================
# PROVIDER - ProxyLLM
# ==========================================

PROVIDER_BASE_URL=https://api.proxyllm.eu/v1
PROVIDER_TIMEOUT_MS=120000


# ==========================================
# AGENT A - GPT 5.6 LUNA
# ==========================================

AGENT_A_NAME=GPT 5.6 Luna - 1
AGENT_A_API_KEY=
AGENT_A_MODEL=gpt-5.6-luna
AGENT_A_BASE_URL=
# AGENT_A_TIMEOUT_MS=120000


# ==========================================
# AGENT B - GPT 5.6 LUNA
# ==========================================

AGENT_B_NAME=GPT 5.6 Luna - 2
AGENT_B_API_KEY=
AGENT_B_MODEL=gpt-5.6-luna
AGENT_B_BASE_URL=
# AGENT_B_TIMEOUT_MS=120000


# ==========================================
# AGENT C - GPT 5.6 LUNA
# ==========================================

AGENT_C_NAME=GPT 5.6 Luna - 3
AGENT_C_API_KEY=
AGENT_C_MODEL=gpt-5.6-luna
AGENT_C_BASE_URL=
# AGENT_C_TIMEOUT_MS=120000


# ==========================================
# AGENT D - GPT 5.6 LUNA
# ==========================================

AGENT_D_NAME=GPT 5.6 Luna - 4
AGENT_D_API_KEY=
AGENT_D_MODEL=gpt-5.6-luna
AGENT_D_BASE_URL=
# AGENT_D_TIMEOUT_MS=120000


# ==========================================
# SERVER & ROOM
# ==========================================

HOST=127.0.0.1
PORT=3000

# Giới hạn số lượt tối đa để tránh một phiên chạy vô hạn.
HARD_TURN_LIMIT=200

# false = tất cả client dùng chung default-room.
MULTI_ROOM_ENABLED=false
MAX_ROOMS=30
ROOM_TTL_MS=43200000

# Legacy two-agent auto-end. Multi-agent runtime thường kết thúc bằng turn limit hoặc user control.
AGENT_AUTO_END_ENABLED=false


# ==========================================
# WEB SEARCH - Tavily
# ==========================================

TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_COUNTRY=

WEB_SEARCH_MAX_QUERIES=2
WEB_SEARCH_RESULTS_PER_QUERY=8
WEB_SEARCH_MAX_SOURCES=8
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_TRUSTED_DOMAINS=
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search

# Optional: đọc sâu một số trang sau khi Tavily trả kết quả.
WEB_RESEARCH_DEEP_ENABLED=true
WEB_RESEARCH_DEEP_MAX_SOURCES=2
WEB_RESEARCH_DEEP_MAX_CHARS=9000
WEB_RESEARCH_DEEP_TIMEOUT_MS=9000


# ==========================================
# CONTEXT MANAGEMENT
# ==========================================

CONTEXT_RECENT_MESSAGES=18
CONTEXT_SUMMARIZE_AFTER=28
CONTEXT_SUMMARY_CHUNK=16
CONTEXT_SUMMARY_MAX_CHARS=6500
LOOP_SIMILARITY_THRESHOLD=0.74


# ==========================================
# IMAGE GENERATION
# ==========================================

IMAGE_GEN_ENABLED=false
IMAGE_GEN_PROVIDER=cloudflare
IMAGE_GEN_MODEL=@cf/black-forest-labs/flux-1-schnell

# Không commit Account ID / API token thật vào repo public.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_ENDPOINT=
IMAGE_GEN_SIZE=1024x1024
IMAGE_GEN_TIMEOUT_MS=120000
IMAGE_GEN_MAX_BYTES=26214400

# Cho phép đưa ảnh đã tạo trở lại context của model.
MODEL_IMAGE_INPUT_ENABLED=true
MODEL_IMAGE_MAX_ATTACHMENTS=1
MODEL_IMAGE_MAX_BYTES=8388608

# Cho phép agent tự gọi tool tạo ảnh khi IMAGE_GEN_ENABLED=true.
AGENT_IMAGE_TOOL_ENABLED=true
AGENT_IMAGE_TOOL_MAX_CALLS_PER_TURN=1
