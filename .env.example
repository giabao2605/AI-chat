# ==========================================
# PROVIDER - ProxyLLM
# ==========================================

PROVIDER_BASE_URL=https://api.proxyllm.eu/v1
# Nếu tất cả agent dùng chung một ProxyLLM key, điền ở đây một lần.
# AGENT_X_API_KEY nếu có sẽ override key chung cho riêng agent đó.
PROVIDER_API_KEY=
PROVIDER_TIMEOUT_MS=120000


# ==========================================
# AGENT A - GPT 5.6 LUNA
# ==========================================

AGENT_A_NAME=GPT 5.6 Luna - 1
AGENT_A_API_KEY=
AGENT_A_MODEL=gpt-5.6-luna
AGENT_A_BASE_URL=
# AGENT_A_TIMEOUT_MS=120000


# ==========================================
# AGENT B - GPT 5.6 LUNA
# ==========================================

AGENT_B_NAME=GPT 5.6 Luna - 2
AGENT_B_API_KEY=
AGENT_B_MODEL=gpt-5.6-luna
AGENT_B_BASE_URL=
# AGENT_B_TIMEOUT_MS=120000


# ==========================================
# AGENT C - GPT 5.6 LUNA (optional)
# ==========================================

AGENT_C_NAME=GPT 5.6 Luna - 3
AGENT_C_API_KEY=
AGENT_C_MODEL=gpt-5.6-luna
AGENT_C_BASE_URL=
# AGENT_C_TIMEOUT_MS=120000


# ==========================================
# AGENT D - GPT 5.6 LUNA (optional)
# ==========================================

AGENT_D_NAME=GPT 5.6 Luna - 4
AGENT_D_API_KEY=
AGENT_D_MODEL=gpt-5.6-luna
AGENT_D_BASE_URL=
# AGENT_D_TIMEOUT_MS=120000


# ==========================================
# AGENT E - GPT 5.6 LUNA (optional)
# ==========================================

AGENT_E_NAME=GPT 5.6 Luna - 5
AGENT_E_API_KEY=
AGENT_E_MODEL=gpt-5.6-luna
AGENT_E_BASE_URL=
# AGENT_E_TIMEOUT_MS=120000


# ==========================================
# AGENT F - GPT 5.6 LUNA (optional)
# ==========================================

AGENT_F_NAME=GPT 5.6 Luna - 6
AGENT_F_API_KEY=
AGENT_F_MODEL=gpt-5.6-luna
AGENT_F_BASE_URL=
# AGENT_F_TIMEOUT_MS=120000


# ==========================================
# SERVER & ROOM
# ==========================================

HOST=127.0.0.1
PORT=3000

# Giới hạn số lượt tối đa để tránh một phiên chạy vô hạn.
HARD_TURN_LIMIT=200

# false = tất cả client dùng chung default-room.
MULTI_ROOM_ENABLED=false
MAX_ROOMS=30
ROOM_TTL_MS=43200000

# Legacy two-agent auto-end. Multi-agent runtime thường kết thúc bằng turn limit hoặc user control.
AGENT_AUTO_END_ENABLED=false


# ==========================================
# WEB SEARCH - Tavily
# ==========================================

TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_COUNTRY=

WEB_SEARCH_MAX_QUERIES=2
WEB_SEARCH_RESULTS_PER_QUERY=8
WEB_SEARCH_MAX_SOURCES=8
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_TRUSTED_DOMAINS=
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search

# Optional: đọc sâu một số trang sau khi Tavily trả kết quả.
WEB_RESEARCH_DEEP_ENABLED=true
WEB_RESEARCH_DEEP_MAX_SOURCES=2
WEB_RESEARCH_DEEP_MAX_CHARS=9000
WEB_RESEARCH_DEEP_TIMEOUT_MS=9000


# ==========================================
# CONTEXT MANAGEMENT
# ==========================================

# Transcript chung vẫn được nén trung tính khi quá dài.
CONTEXT_RECENT_MESSAGES=18
CONTEXT_SUMMARIZE_AFTER=28
CONTEXT_SUMMARY_CHUNK=16
CONTEXT_SUMMARY_MAX_CHARS=6500
LOOP_SIMILARITY_THRESHOLD=0.74

# Budget áp dụng cho request chính của từng agent sau khi memory/private/web context đã được lắp.
# Đặt 0 để tắt budget và giữ behavior cũ.
CONTEXT_INPUT_BUDGET_TOKENS=12000
CONTEXT_BUDGET_SAFETY_MARGIN=0.12
# Ảnh không có token cost portable giữa provider/model; reserve này chỉ là khoảng an toàn để budgeting.
CONTEXT_IMAGE_TOKEN_RESERVE=1500
# Số recent message gần nhất luôn được giữ nếu có thể.
CONTEXT_MIN_RECENT_MESSAGES=4
# Optional override cho từng agent A-F; 0 hoặc bỏ trống = dùng budget global.
# AGENT_A_CONTEXT_BUDGET_TOKENS=16000
# AGENT_B_CONTEXT_BUDGET_TOKENS=16000


# ==========================================
# AGENT MEMORY
# ==========================================

# Mỗi agent có long-term memory riêng, lưu bền qua nhiều phiên.
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_DB_PATH=./data/agent-memory.sqlite

# agent = memory đi theo từng agent A-F giữa các room; room = cô lập theo từng room.
AGENT_MEMORY_SCOPE=agent

AGENT_MEMORY_RETRIEVAL_LIMIT=8
AGENT_MEMORY_CONTEXT_MAX_CHARS=6500
# Ghi memory theo batch để giảm hidden model calls. Private context là session-only.
AGENT_MEMORY_CONSOLIDATE_EVERY_MESSAGES=16
AGENT_MEMORY_MAX_CANDIDATES_PER_PASS=6
AGENT_MEMORY_MIN_IMPORTANCE=0.35
AGENT_MEMORY_MAX_ITEM_CHARS=1800


# ==========================================
# IMAGE GENERATION
# ==========================================

IMAGE_GEN_ENABLED=false
IMAGE_GEN_PROVIDER=cloudflare
IMAGE_GEN_MODEL=@cf/black-forest-labs/flux-1-schnell

# Không commit Account ID / API token thật vào repo public.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

IMAGE_GEN_SIZE=1024x1024
IMAGE_GEN_TIMEOUT_MS=120000
IMAGE_GEN_MAX_BYTES=26214400

# Cho phép đưa ảnh đã tạo trở lại context của model.
MODEL_IMAGE_INPUT_ENABLED=true
MODEL_IMAGE_MAX_ATTACHMENTS=1
MODEL_IMAGE_MAX_BYTES=8388608

# Cho phép agent tự gọi tool tạo ảnh khi IMAGE_GEN_ENABLED=true.
AGENT_IMAGE_TOOL_ENABLED=true
AGENT_IMAGE_TOOL_MAX_CALLS_PER_TURN=1
