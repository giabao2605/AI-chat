# Shared provider URL. Use an OpenAI-compatible base URL that exposes /chat/completions.
PROVIDER_BASE_URL=

# Agent A
AGENT_A_NAME=GPT
AGENT_A_API_KEY=
AGENT_A_MODEL=model-a
AGENT_A_BASE_URL=

# Agent B
AGENT_B_NAME=Claude
AGENT_B_API_KEY=
AGENT_B_MODEL=model-b
AGENT_B_BASE_URL=

# Independent web search tool (Tavily Search API).
# Free Researcher plan currently includes 1,000 API credits/month.
# When TAVILY_API_KEY is present, web search is enabled by default.
# Set WEB_SEARCH_ENABLED=false to disable it without removing the key.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true

# Optional country bias. Tavily expects a country name, e.g. vietnam, united states.
# Leave blank for broad/global coverage. Common short aliases such as VN/US are normalized by the app.
WEB_SEARCH_COUNTRY=

# Free-tier friendly defaults. Each basic Tavily search costs 1 API credit.
# One AI research turn can therefore use up to WEB_SEARCH_MAX_QUERIES credits.
WEB_SEARCH_MAX_QUERIES=2
WEB_SEARCH_RESULTS_PER_QUERY=8
WEB_SEARCH_MAX_SOURCES=8
WEB_SEARCH_TIMEOUT_MS=15000

# Optional comma-separated domains to boost in local ranking, e.g. who.int,nasa.gov,reuters.com
WEB_SEARCH_TRUSTED_DOMAINS=

# Usually leave this unchanged. Useful for mocks or a compatible proxy.
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search

# Agent self-ending is temporarily disabled by default.
# Set true later if you want agents to decide when a conversation is finished again.
AGENT_AUTO_END_ENABLED=false

# Server
HOST=127.0.0.1
PORT=3000

# Safety guard against an accidental infinite paid loop.
HARD_TURN_LIMIT=200
